# Copia el contenido de este archivo y pégalo en la 
# pestaña "Environment" de tu servicio en Render.

# --------------------------------------------------------
# 1. FIREBASE CLOUD (Obligatorio para Base de datos y Auth)
# --------------------------------------------------------
# Encuentra estos valores en tu Consola de Firebase -> Configuración del Proyecto -> General
FIREBASE_API_KEY=AIzaSyBt9pqBxcSOWVSm7fSBJtYSmmPgrb8A_rU
FIREBASE_AUTH_DOMAIN=alero-company-works.firebaseapp.com
FIREBASE_PROJECT_ID=alero-company-works
FIREBASE_STORAGE_BUCKET=alero-company-works.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=16044531269
FIREBASE_APP_ID=1:16044531269:web:431da21bd13952050d8d2c

# (Opcional) Service Account para Firebase Admin SDK (Recomendado para endpoints seguros)
# Debe ser un string JSON minificado de las credenciales de servicio (Service Accounts)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# --------------------------------------------------------
# 2. GROQ AI COPILOT (Obligatorio para el Asistente AI)
# --------------------------------------------------------
# Genera tu API Key gratuita en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tUAPIKEYGROQ...

# --------------------------------------------------------
# 3. NOTIFICACIONES DISCORD (Opcional)
# --------------------------------------------------------
# Webhook URL para enviar alertas automáticas (Ej: bajadas de precio, nuevos deploys)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --------------------------------------------------------
# 4. CONFIGURACIÓN DEL SERVIDOR
# --------------------------------------------------------
# Render inyecta PORT automáticamente, pero puedes forzarlo si trabajas en local
PORT=3000
NODE_ENV=production
